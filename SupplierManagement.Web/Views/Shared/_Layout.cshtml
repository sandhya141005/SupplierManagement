@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supplier Hub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SupplierManagement.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Supplier" asp-action="Index">
                    Supplier Hub
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-label="Toggle navigation"
                        style="border-color:rgba(215,204,200,0.4);">
                    <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
                </button>

                @{
                    var role = Context.Session.GetString("Role");
                    var userName = Context.Session.GetString("UserName");
                }

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">

                    <ul class="navbar-nav flex-grow-1">

                        @if (!string.IsNullOrEmpty(role))
                        {
                            @if (role == "User")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Supplier"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Cart"
                                       asp-action="Index">
                                        My Cart
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Purchases"
                                       asp-action="Index">
                                        My Purchases
                                    </a>
                                </li>
                            }
                            else if (role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Supplier"
                                       asp-action="Index">
                                        Home
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Supplier"
                                       asp-action="Analytics">
                                        Supplier Analytics
                                    </a>
                                </li>
                            }
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center" style="gap:0.5rem;">

                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                <span class="navbar-user-badge">
                                    <span style="font-size:1rem;">&#9786;</span>
                                    @userName

                                    @if (role == "Admin")
                                    {
                                        <span class="badge-admin" style="margin-left:4px;">
                                            Admin
                                        </span>
                                    }
                                </span>
                            </li>

                            <li class="nav-item">
                                @using (Html.BeginForm("Logout", "Auth", FormMethod.Post,
                                    new { style = "display:inline;" }))
                                {
                                    <button type="submit"
                                            class="nav-link nav-logout"
                                            style="background:none;border:none;cursor:pointer;">
                                        Sign out
                                    </button>
                                }
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="@(Url.Content("~/lib/jquery/dist/jquery.min.js"))"></script>
    <script src="@(Url.Content("~/lib/jquery-validation/dist/jquery.validate.min.js"))"></script>
    <script src="@(Url.Content("~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"))"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>