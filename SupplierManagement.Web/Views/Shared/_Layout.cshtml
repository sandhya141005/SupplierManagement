<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supplier Hub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SupplierManagement.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Supplier" asp-action="Index">
                    &#9752; Supplier Hub
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-label="Toggle navigation" style="border-color:rgba(215,204,200,0.4);">
                    <span class="navbar-toggler-icon" style="filter:invert(1);"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between align-items-center">
                    <ul class="navbar-nav flex-grow-1">
                        @{
                            var role = Context.Session.GetString("Role");
                            var userName = Context.Session.GetString("UserName");
                        }
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Supplier" asp-action="Index">Home</a>
                            </li>

                            @if (role == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Supplier" asp-action="Add">Add Supplier</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Supplier" asp-action="Analytics">Analytics</a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cart" asp-action="Index">My Cart</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Order" asp-action="Index">My Purchases</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center" style="gap:0.5rem;">
                        @if (!string.IsNullOrEmpty(role))
                        {
                            <li class="nav-item">
                                <span class="navbar-user-badge">
                                    <span style="font-size:1rem;">&#9786;</span>
                                    @userName
                                    @if (role == "Admin")
                                    {
                                        <span class="badge-admin" style="margin-left:4px;">Admin</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-logout" asp-controller="Auth" asp-action="Login">Sign out</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top">
        <div class="container" style="line-height:60px;">
            &copy; 2026 &mdash; Supplier Hub &nbsp;&bull;&nbsp;
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
