@model SupplierManagement.Web.Models.AnalyticsViewModel
@{
    ViewData["Title"] = "Supplier Analytics";
    var supplierLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.SupplierRevenue.Select(x => x.SupplierName).ToList());
    var supplierRevenue = System.Text.Json.JsonSerializer.Serialize(
        Model.SupplierRevenue.Select(x => x.TotalRevenue).ToList());
    var supplierOrders = System.Text.Json.JsonSerializer.Serialize(
        Model.SupplierRevenue.Select(x => x.TotalOrders).ToList());

    var countryLabels = System.Text.Json.JsonSerializer.Serialize(
        Model.CountrySales.Select(x => x.CountryName).ToList());
    var countryRevenue = System.Text.Json.JsonSerializer.Serialize(
        Model.CountrySales.Select(x => x.TotalRevenue).ToList());
    var countryOrders = System.Text.Json.JsonSerializer.Serialize(
        Model.CountrySales.Select(x => x.TotalOrders).ToList());
}

<div style="max-width:1100px; margin:0 auto; padding:1.5rem;">
    <h2 style="margin-bottom:1.5rem;">Supplier Analytics</h2>

    @if (!Model.SupplierRevenue.Any() && !Model.CountrySales.Any())
    {
        <div class="empty-state">
            <h3>No order data yet</h3>
            <p>Analytics will appear once orders are placed.</p>
        </div>
    }
    else
    {
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; margin-bottom:2rem;">
            <div class="form-card" style="text-align:center; padding:1.25rem;">
                <div style="font-size:1.8rem; font-weight:700; color:var(--rc-dark);">
                    @Model.SupplierRevenue.Count
                </div>
                <div style="color:var(--rc-hint); font-size:0.85rem;">Active Suppliers</div>
            </div>
            <div class="form-card" style="text-align:center; padding:1.25rem;">
                <div style="font-size:1.8rem; font-weight:700; color:var(--rc-dark);">
                    ₹@Model.SupplierRevenue.Sum(x => x.TotalRevenue).ToString("0.00")
                </div>
                <div style="color:var(--rc-hint); font-size:0.85rem;">Total Revenue</div>
            </div>
            <div class="form-card" style="text-align:center; padding:1.25rem;">
                <div style="font-size:1.8rem; font-weight:700; color:var(--rc-dark);">
                    @Model.CountrySales.Count
                </div>
                <div style="color:var(--rc-hint); font-size:0.85rem;">Countries</div>
            </div>
        </div>

        <div class="form-card" style="margin-bottom:2rem; padding:1.5rem;">
            <h3 style="margin-bottom:1rem;">Revenue by Supplier</h3>
            <canvas id="supplierChart" height="100"></canvas>
        </div>

        <div class="form-card" style="margin-bottom:2rem; padding:1.5rem;">
            <h3 style="margin-bottom:1rem;">Sales by Country</h3>
            <canvas id="countryChart" height="100"></canvas>
        </div>

        <div class="form-card table-card" style="margin-bottom:2rem;">
            <h3 style="padding:1rem 1rem 0;">Supplier Breakdown</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Supplier</th>
                        <th>Total Revenue</th>
                        <th>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.SupplierRevenue)
                    {
                        <tr>
                            <td>@s.SupplierName</td>
                            <td>₹@s.TotalRevenue.ToString("0.00")</td>
                            <td>@s.TotalOrders</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="form-card table-card">
            <h3 style="padding:1rem 1rem 0;">Country Breakdown</h3>
            <table class="table">
                <thead>
                    <tr>
                        <th>Country</th>
                        <th>Total Revenue</th>
                        <th>Orders</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CountrySales)
                    {
                        <tr>
                            <td>@c.CountryName</td>
                            <td>₹@c.TotalRevenue.ToString("0.00")</td>
                            <td>@c.TotalOrders</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const supplierLabels  = @Html.Raw(supplierLabels);
    const supplierRevenue = @Html.Raw(supplierRevenue);
    const supplierOrders  = @Html.Raw(supplierOrders);
    const countryLabels   = @Html.Raw(countryLabels);
    const countryRevenue  = @Html.Raw(countryRevenue);
    const countryOrders   = @Html.Raw(countryOrders);

    new Chart(document.getElementById('supplierChart'), {
        type: 'bar',
        data: {
            labels: supplierLabels,
            datasets: [
                {
                    label: 'Revenue (₹)',
                    data: supplierRevenue,
                    backgroundColor: 'rgba(93, 64, 55, 0.7)',
                    borderColor: 'rgba(93, 64, 55, 1)',
                    borderWidth: 1,
                    yAxisID: 'y'
                },
                {
                    label: 'Orders',
                    data: supplierOrders,
                    backgroundColor: 'rgba(188, 170, 164, 0.7)',
                    borderColor: 'rgba(188, 170, 164, 1)',
                    borderWidth: 1,
                    type: 'line',
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            scales: {
                y: {
                    type: 'linear',
                    position: 'left',
                    title: { display: true, text: 'Revenue (₹)' }
                },
                y1: {
                    type: 'linear',
                    position: 'right',
                    title: { display: true, text: 'Orders' },
                    grid: { drawOnChartArea: false }
                }
            }
        }
    });

    new Chart(document.getElementById('countryChart'), {
        type: 'bar',
        data: {
            labels: countryLabels,
            datasets: [
                {
                    label: 'Revenue (₹)',
                    data: countryRevenue,
                    backgroundColor: 'rgba(78, 52, 46, 0.7)',
                    borderColor: 'rgba(78, 52, 46, 1)',
                    borderWidth: 1,
                    yAxisID: 'y'
                },
                {
                    label: 'Orders',
                    data: countryOrders,
                    backgroundColor: 'rgba(215, 204, 200, 0.7)',
                    borderColor: 'rgba(215, 204, 200, 1)',
                    borderWidth: 1,
                    type: 'line',
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            indexAxis: 'y',
            interaction: { mode: 'index', intersect: false },
            scales: {
                y: { title: { display: true, text: 'Country' } },
                y1: {
                    type: 'linear',
                    position: 'right',
                    title: { display: true, text: 'Orders' },
                    grid: { drawOnChartArea: false }
                }
            }
        }
    });
</script>