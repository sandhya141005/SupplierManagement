@model SupplierManagement.Web.Models.OrderViewModel

<div class="form-card form-card-wide"  style="max-width:1000px; width:95%;" >
    <div style="text-align:center; margin-bottom:1.5rem;">
        <div style="font-size:3rem;">✓</div>
        <h2 style="color:#2e7d32;">Order Placed!</h2>
        <p style="color:#666;">Your order has been confirmed.</p>
    </div>

    <div style="background:#f9f9f9; border-radius:8px; padding:1rem; margin-bottom:1.5rem;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div><strong>Order ID:</strong> @Model.OrderNumber</div>
            <div><strong>Date:</strong> @Model.OrderDate</div>
        </div>
    </div>

    <h3>Bill Summary</h3>
    <div class="table-card">
        <table class="table">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Discount</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td>@item.Price.ToString("0.00")</td>
                        <td>@item.Discount.ToString("0.00")</td>
                        <td>@item.Quantity</td>
                        <td>@item.LineTotal.ToString("0.00")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" style="text-align:right; font-weight:bold;">Grand Total</td>
                    <td style="font-weight:bold; font-size:1.1rem;">₹@Model.TotalAmount.ToString("0.00")</td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="form-actions">
        @Html.ActionLink("My Purchases", "Index", "Purchases", null, new { @class = "btn-secondary-rc" })
        @Html.ActionLink("Continue Shopping", "Index", "Supplier", null, new { @class = "btn-primary-rc" })
    </div>
</div>