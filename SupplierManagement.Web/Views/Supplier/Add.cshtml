@model SupplierManagement.Web.Models.SupplierViewModel
@{
    ViewData["Title"] = "Add Supplier";
}

<div class="form-card form-card-wide">
    <h2>Add Supplier</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="error-message">@Model.ErrorMessage</div>
    }

    @using (Html.BeginForm("Add", "Supplier", FormMethod.Post, new { autocomplete = "off" }))
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 1.25rem;">
            <div class="form-group" style="grid-column:1/-1;">
                @Html.LabelFor(m => m.CompanyName, "Company Name")
                @Html.TextBoxFor(m => m.CompanyName, new { placeholder = "e.g. Artisan Goods Co." })
                @Html.ValidationMessageFor(m => m.CompanyName, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CatalogType, "Catalog Type")
                @Html.TextBoxFor(m => m.CatalogType, new { placeholder = "e.g. Electronics" })
                @Html.ValidationMessageFor(m => m.CatalogType, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TotalProducts, "Total Products")
                @Html.TextBoxFor(m => m.TotalProducts, new { placeholder = "0" })
                @Html.ValidationMessageFor(m => m.TotalProducts, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

            <div class="form-group" style="grid-column:1/-1;">
                @Html.LabelFor(m => m.ContactNo, "Contact Number")
                @Html.TextBoxFor(m => m.ContactNo, new { placeholder = "Phone number" })
                @Html.ValidationMessageFor(m => m.ContactNo, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
        </div>

        <div class="form-group">
            <label>Payment Methods</label>
            <div class="payment-checkboxes">
                @foreach (var method in SupplierManagement.Web.Models.PaymentMethodsList.All)
                {
                    <label>
                        <input type="checkbox" name="SelectedPaymentMethods" value="@method"
                        @(Model.SelectedPaymentMethods.Contains(method) ? "checked" : "") />
                        @method
                    </label>
                }
            </div>
            @Html.ValidationMessageFor(m => m.SelectedPaymentMethods, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <hr class="divider" />

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0 1.25rem;">
            <div class="form-group">
                @Html.LabelFor(m => m.CountryId, "Country")
                @Html.DropDownListFor(m => m.CountryId,
                    new SelectList(Model.Countries, "Value", "Text"),
                    "Select country", new { id = "CountryId" })
                @Html.ValidationMessageFor(m => m.CountryId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.StateId, "State")
                @Html.DropDownListFor(m => m.StateId,
                    new SelectList(Model.States, "Value", "Text"),
                    "Select state", new { id = "StateId" })
                @Html.ValidationMessageFor(m => m.StateId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.CityId, "City")
                @Html.DropDownListFor(m => m.CityId,
                    new SelectList(Model.Cities, "Value", "Text"),
                    "Select city", new { id = "CityId" })
                @Html.ValidationMessageFor(m => m.CityId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
        </div>

        <div class="form-actions">
            <button type="submit">Add Supplier</button>
            @Html.ActionLink(
    "Cancel",
    "Index",
    "Supplier",
    null,
    new { @class = "btn-secondary-rc" }
)
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('CountryId').addEventListener('change', function () {
            const countryId = this.value;
            const stateDropdown = document.getElementById('StateId');
            const cityDropdown = document.getElementById('CityId');
            stateDropdown.innerHTML = '<option value="">Select state</option>';
            cityDropdown.innerHTML = '<option value="">Select city</option>';
            if (!countryId) return;
            fetch(`/Auth/GetStates?countryId=${countryId}`)
                .then(r => r.json())
                .then(states => {
                    states.forEach(s => {
                        const opt = document.createElement('option');
                        opt.value = s.value; opt.text = s.text;
                        stateDropdown.appendChild(opt);
                    });
                });
        });
        document.getElementById('StateId').addEventListener('change', function () {
            const stateId = this.value;
            const cityDropdown = document.getElementById('CityId');
            cityDropdown.innerHTML = '<option value="">Select city</option>';
            if (!stateId) return;
            fetch(`/Auth/GetCities?stateId=${stateId}`)
                .then(r => r.json())
                .then(cities => {
                    cities.forEach(c => {
                        const opt = document.createElement('option');
                        opt.value = c.value; opt.text = c.text;
                        cityDropdown.appendChild(opt);
                    });
                });
        });
    </script>
}
