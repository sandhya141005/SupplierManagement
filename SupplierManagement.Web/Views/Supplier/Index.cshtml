@model List<SupplierManagement.Web.Models.SupplierViewModel>
@{
    ViewData["Title"] = "Suppliers";
    var isAdmin = ViewBag.IsAdmin == true;
}
<div class="page-header">
    <h2>@(isAdmin ? "Manage Suppliers" : "Our Suppliers")</h2>
    @if (isAdmin)
    {
        <div class="d-flex align-items-center gap-2">
            @Html.ActionLink( "+ Add Supplier", "Add","Supplier", null,new { @class = "btn-primary-rc" } )
            @Html.ActionLink("Download Excel", "DownloadExcel", "Supplier",null, new { @class = "btn-secondary-rc" })
        </div>
    }
</div>
<!--search-->
<div style="margin-bottom:1.5rem; ">
    <input type="text" id="searchBox" placeholder="Search by company name or category..."
           style="width:100%; max-width:420px; padding:8px 14px; border:1px solid #ccc; border-radius:6px; font-size:0.95rem; " />
</div>
@if (!Model.Any())
{
    <div class="empty-state">
        <h3>No suppliers yet</h3>
        <p>@(isAdmin ? "Add your first supplier to get started." : "Check back soon.")</p>
    </div>
}
else if (isAdmin)
{
    <div class="table-card">
        <table>
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Products</th>
                    <th>Catalog</th>
                    <th>Payment Methods</th>
                    <th>Added On</th>
                    <th>Location</th>
                    <th>Contact</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr class="supplier-row" data-company="@s.CompanyName.ToLower()" data-category="@s.CatalogType.ToLower()">
                        <td style="font-weight:600; color:var(--rc-dark);">@Html.ActionLink(
                                                                                                                    s.CompanyName,
                                                                                                                    "Details",
                                                                                                                    "Supplier",
                                                                                                                    new { id = s.SupplierId },
                                                                                                                    null
                                                                                                                )</td>
                            <td>@s.TotalProducts</td>
                            <td>
                                <span
                                    style="background:var(--rc-pale); color:var(--rc-subtext); border-radius:20px; padding:2px 10px; font-size:0.78rem; font-weight:600;">
                                    @s.CatalogType
                                </span>
                            </td>
                            <td style="max-width:180px; font-size:0.82rem; color:var(--rc-hint);">@s.PaymentMethodsAllowed</td>
                            @Html.Raw($"<td>{Html.Encode(s.CreatedDate)}</td>")
                            <td style="font-size:0.85rem;">@s.City, @s.State</td>
                            <td style="font-size:0.85rem;">@s.ContactNo</td>
                            <td>
                                <div class="action-buttons">
                                    @Html.ActionLink(
        "Edit",
        "Edit",
        "Supplier",
        new { id = s.SupplierId },
        new { @class = "btn-primary-rc btn-sm" }
    )

                                    @using (Html.BeginForm("Delete", "Supplier",
                                            new { id = s.SupplierId },
                                            FormMethod.Post,
                                            null,
                                            new { style = "display:inline;" }))
                                    {
                                        <button type="submit" class="btn-danger-rc btn-sm"
                                                onclick="return confirm('Delete @s.CompanyName? This cannot be undone.');">
                                            Delete
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p id="noResults" style="display:none; color:#888; padding:1rem;">No suppliers match your search.</p>
        </div>
    }
else
    {
        <!-- User: card grid view -->
        <div class="supplier-cards-grid">
            @foreach (var s in Model)
            {
                <div class="supplier-card" data-company="@s.CompanyName.ToLower()" data-category="@s.CatalogType.ToLower()">
                    <div class="card-company">@Html.ActionLink(
                                                                                                                        s.CompanyName,
                                                                                                                        "Details",
                                                                                                                        "Supplier",
                                                                                                                        new { id = s.SupplierId },
                                                                                                                        null
                                                                                                                    )</div>
                        <div class="card-meta">@s.City, @s.State &middot; @s.Country</div>

                        <div>
                            <span class="card-tag">@s.CatalogType</span>
                            <span class="card-tag">@s.TotalProducts products</span>
                        </div>

                        <div style="font-size:0.8rem; color:var(--rc-hint); margin-top:8px;">
                            Accepts: @s.PaymentMethodsAllowed
                        </div>

                        <div class="card-footer">
                            <span style="font-size:0.8rem; color:var(--rc-muted);">&#9742; @s.ContactNo</span>
                            @Html.ActionLink("View Products", "Details", "Supplier",
    new { id = s.SupplierId },
    new { @class = "btn-primary-rc", style = "padding:0.4rem 1rem; font-size:0.85rem;" })

                        </div>
                    </div>
                }
            </div>
        }
        <script src="/js/index.js"></script>