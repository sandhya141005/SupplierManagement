@model SupplierManagement.Web.Models.SupplierViewModel
@{
    bool isEdit = Model.SupplierId > 0;
    string formTitle = isEdit ? "Edit Supplier" : "Add Supplier";
    string formAction = isEdit ? "Edit" : "Add";
    string submitLabel = isEdit ? "Save Changes" : "Add Supplier";
    object routeValues = isEdit ? (object)new { id = Model.SupplierId } : null;
}

<div class="form-card form-card-wide">
    <h2>@formTitle</h2>

    <!-- Only product count/logic errors go here -->
    <div id="jsErrorBox" class="error-message" style="display:none;"></div>

    @using (Html.BeginForm(formAction, "Supplier", routeValues, FormMethod.Post, null, new
    {
        autocomplete = "off",
        novalidate = "novalidate",
        id = "supplierForm"
    }))
    {
        @if (isEdit)
        {
            @Html.HiddenFor(m => m.SupplierId)
        }

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 1.25rem;">

            <div class="form-group" style="grid-column:1/-1;">
                @Html.LabelFor(m => m.CompanyName, "Company Name")
                @Html.TextBoxFor(m => m.CompanyName, new { placeholder = "e.g. Artisan Goods Co." })
                @Html.ValidationMessageFor(m => m.CompanyName, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.CatalogType, "Catalog Type")
                @Html.TextBoxFor(m => m.CatalogType, new { placeholder = "e.g. Electronics", id = "CatalogType" })
                @Html.ValidationMessageFor(m => m.CatalogType, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.TotalProducts, "Total Products")
                @Html.TextBoxFor(m => m.TotalProducts, new { placeholder = "0", id = "TotalProducts", type = "number", min = "1" })
                @Html.ValidationMessageFor(m => m.TotalProducts, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

           <div class="form-group">
    @Html.LabelFor(m => m.CreatedDate, "Created Date")
    @Html.TextBoxFor(m => m.CreatedDate, new { placeholder = "e.g. 11-Jun-2026" })
    @Html.ValidationMessageFor(m => m.CreatedDate, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
</div>

            <div class="form-group" style="grid-column:1/-1;">
                @Html.LabelFor(m => m.ContactNo, "Contact Number")
                @Html.TextBoxFor(m => m.ContactNo, new { placeholder = "Phone number (optional)" })
                @Html.ValidationMessageFor(m => m.ContactNo, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>

        </div>

        <div class="form-group">
            <label>Payment Methods</label>
            <div class="payment-checkboxes">
                @foreach (var method in SupplierManagement.Web.Models.PaymentMethodsList.All)
                {
                    <label>
                        <input type="checkbox" name="SelectedPaymentMethods" value="@method"
                        @(Model.SelectedPaymentMethods.Contains(method) ? "checked" : "") />
                        @method
                    </label>
                }
            </div>
            @Html.ValidationMessageFor(m => m.SelectedPaymentMethods, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <hr class="divider" />

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0 1.25rem;">
            <div class="form-group">
                @Html.LabelFor(m => m.CountryId, "Country")
                @Html.DropDownListFor(m => m.CountryId, new SelectList(Model.Countries, "Value", "Text"), "Select country", new { id = "CountryId" })
                @Html.ValidationMessageFor(m => m.CountryId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.StateId, "State")
                @Html.DropDownListFor(m => m.StateId, new SelectList(Model.States, "Value", "Text"), "Select state", new { id = "StateId" })
                @Html.ValidationMessageFor(m => m.StateId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.CityId, "City")
                @Html.DropDownListFor(m => m.CityId, new SelectList(Model.Cities, "Value", "Text"), "Select city", new { id = "CityId" })
                @Html.ValidationMessageFor(m => m.CityId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
        </div>

        <hr class="divider" />

        <h3>Products <span id="productCountLabel" style="font-size:0.85rem;font-weight:400;"></span></h3>
        <div id="productsContainer">
            @for (int i = 0; i < Model.Products.Count; i++)
            {
                <div class="product-card" data-product-id="@Model.Products[i].ProductId"
                     style="border:1px solid #ddd; border-radius:8px; padding:12px; margin-bottom:10px; position:relative;">
                    <button type="button" class="btn-danger-rc btn-sm removeProductBtn"
                            style="position:absolute; top:8px; right:8px;">&times;</button>
                    @Html.HiddenFor(m => m.Products[i].ProductId, new { @class = "prod-id" })
                    @Html.HiddenFor(m => m.Products[i].SupplierId)
                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:0 1rem;">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Products[i].ProductName)
                            @Html.TextBoxFor(m => m.Products[i].ProductName, new { @class = "prod-name", placeholder = "Product Name" })
                            @Html.ValidationMessageFor(m => m.Products[i].ProductName, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Products[i].Price)
                            @Html.TextBoxFor(m => m.Products[i].Price, new { @class = "prod-price", type = "number", step = "0.01", min = "0", placeholder = "Price" })
                            @Html.ValidationMessageFor(m => m.Products[i].Price, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Products[i].Discount)
                            @Html.TextBoxFor(m => m.Products[i].Discount, new { @class = "prod-discount", type = "number", step = "0.01", min = "0", placeholder = "Discount" })
                            @Html.ValidationMessageFor(m => m.Products[i].Discount, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Products[i].AvailableStock)
                            @Html.TextBoxFor(m => m.Products[i].AvailableStock, new { @class = "prod-stock", type = "number", min = "0", placeholder = "Stock" })
                            @Html.ValidationMessageFor(m => m.Products[i].AvailableStock, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
                        </div>
                        <div class="form-group" style="grid-column:1/-1;">
                            @Html.LabelFor(m => m.Products[i].Category)
                            @Html.TextBoxFor(m => m.Products[i].Category, new { @class = "prod-category", @readonly = "readonly" })
                        </div>
                        <div class="form-group">
                            @Html.LabelFor(m => m.Products[i].CreatedDate, "Created Date")
                            @{
    string prodDateValue = "";
    if (!string.IsNullOrEmpty(Model.Products[i].CreatedDate))
    {
        if (DateTime.TryParseExact(Model.Products[i].CreatedDate, "dd-MMM-yyyy",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var d1))
        {
            prodDateValue = d1.ToString("yyyy-MM-dd");
        }
        else if (DateTime.TryParse(Model.Products[i].CreatedDate, out var d2))
        {
            prodDateValue = d2.ToString("yyyy-MM-dd");
        }
    }
}
<input type="date"
       name="Products[@i].CreatedDate"
       class="prod-date"
       value="@prodDateValue" />@Html.ValidationMessageFor(m => m.Products[i].CreatedDate, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
                       </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addProductBtn" class="btn-primary-rc" style="margin-top:8px;">+ Add Product</button>
        <div id="hiddenInputsContainer"></div>

        <div class="form-actions">
            <button type="submit">@submitLabel</button>
            @Html.ActionLink("Cancel", "Index", "Supplier", null, new { @class = "btn-secondary-rc" })
        </div>
    }
</div>

<script src="/js/supp.js"></script>
<script>
    initializeSupplierForm({
        isEdit: @(isEdit.ToString().ToLower()),
        supplierId: @Model.SupplierId
    });
</script>