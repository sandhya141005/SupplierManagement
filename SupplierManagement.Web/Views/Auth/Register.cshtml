@model SupplierManagement.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "_Layout";
}

<div class="form-card form-card-wide">
    <h2>Create Account</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="error-message">@Model.ErrorMessage</div>
    }

    @using (Html.BeginForm("Register", "Auth", FormMethod.Post, new { autocomplete = "off" }))
    {
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:0 1.25rem;">
            <div class="form-group">
                @Html.LabelFor(m => m.FirstName, "First Name")
                @Html.TextBoxFor(m => m.FirstName, new { placeholder = "Jane" })
                @Html.ValidationMessageFor(m => m.FirstName, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.LastName, "Last Name")
                @Html.TextBoxFor(m => m.LastName, new { placeholder = "Doe" })
                @Html.ValidationMessageFor(m => m.LastName, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email address")
            @Html.TextBoxFor(m => m.Email, new { placeholder = "you@example.com", autocomplete = "off" })
            @Html.ValidationMessageFor(m => m.Email, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <div class="form-group">
            <label>Gender</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="Gender" value="Male" @(Model.Gender == "Male" ? "checked" : "") />
                    Male
                </label>
                <label>
                    <input type="radio" name="Gender" value="Female" @(Model.Gender == "Female" ? "checked" : "") />
                    Female
                </label>
            </div>
            @Html.ValidationMessageFor(m => m.Gender, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password, "Password")
            @Html.PasswordFor(m => m.Password, new { placeholder = "••••••••", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.Password, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.ContactNo, "Contact Number (optional)")
            @Html.TextBoxFor(m => m.ContactNo, new { placeholder = "10-digit number" })
            @Html.ValidationMessageFor(m => m.ContactNo, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <hr class="divider" />

        <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:0 1.25rem;">
            <div class="form-group">
                @Html.LabelFor(m => m.CountryId, "Country")
                @Html.DropDownListFor(m => m.CountryId,
                    new SelectList(Model.Countries, "Value", "Text"),
                    "Select country",
                    new { id = "CountryId" })
                @Html.ValidationMessageFor(m => m.CountryId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.StateId, "State")
                @Html.DropDownListFor(m => m.StateId,
                    new SelectList(Model.States, "Value", "Text"),
                    "Select state",
                    new { id = "StateId" })
                @Html.ValidationMessageFor(m => m.StateId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
            <div class="form-group">
                @Html.LabelFor(m => m.CityId, "City")
                @Html.DropDownListFor(m => m.CityId,
                    new SelectList(Model.Cities, "Value", "Text"),
                    "Select city",
                    new { id = "CityId" })
                @Html.ValidationMessageFor(m => m.CityId, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
            </div>
        </div>

        <div class="form-group" style="display:flex; align-items:center; gap:8px;">
            @Html.CheckBoxFor(m => m.IsAdmin)
            <label for="IsAdmin"
                   style="text-transform:none; letter-spacing:0; font-weight:500; font-size:0.92rem; margin-bottom:0; cursor:pointer;">
                Register as Administrator
            </label>
        </div>

        <div class="form-actions">
            <button type="submit">Create Account</button>
            <button type="reset" onclick="window.location.href='/auth/register'">Reset</button>
        </div>
    }

    <div class="form-footer-link">
        Already have an account?
        @Html.ActionLink("Sign in", "Login", "Auth", null, new { @style = "font-weight:bold;" })
    </div>
</div> 
<script src="/js/register.js"></script>
