@model SupplierManagement.Web.Models.LoginViewModel
<h2>Login</h2>
@if (Model.ErrorMessage != null)
{
    <p style="color:red">@Model.ErrorMessage</p>
}
@using (Html.BeginForm("Login", "Auth", FormMethod.Post, new { autocomplete = "off" }))
{
    @Html.TextBoxFor(m => m.Email, new { placeholder = "Email", autocomplete = "off" })
    <br />
    @Html.PasswordFor(m => m.Password, new { placeholder = "Password", autocomplete = "new-password" })
    <br />
    <button type="submit">Login</button>
}
@Html.ActionLink("Don't have an account? Register", "Register", "Auth")