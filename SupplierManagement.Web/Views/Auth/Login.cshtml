@model SupplierManagement.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}
<div class="form-card">
    <h2>Sign In</h2>

    @if (Model.ErrorMessage != null)
    {
        <div class="error-message">@Model.ErrorMessage</div>
    }

    @using (Html.BeginForm("Login", "Auth", FormMethod.Post, new { autocomplete = "off" }))
    {
        <div class="form-group">
            @Html.LabelFor(m => m.Email, "Email address")
            @Html.TextBoxFor(m => m.Email, new { placeholder = "you@example.com", autocomplete = "off", @class = "" })
            @Html.ValidationMessageFor(m => m.Email, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password, "Password")
            @Html.PasswordFor(m => m.Password, new { placeholder = "••••••••", autocomplete = "new-password" })
            @Html.ValidationMessageFor(m => m.Password, "", new { style = "color:#B71C1C;font-size:0.8rem;" })
        </div>

        <div class="form-actions">
            <button type="submit">Sign In</button>
        </div>
    }

    <div class="form-footer-link">
        Don't have an account?
        @Html.ActionLink("Register", "Register", "Auth",null,new { @style = "font-weight:bold;" })
    </div>

</div>
