@model SupplierManagement.Web.Models.Revenue.RevenueInsightsModel

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}
else
{
    

    <div class="card">
        <div class="card-header  text-white">
            <strong >AI Answer</strong>
        </div>
        <div class="card-body">
            <p style="white-space: pre-line;">@Model.AiAnswer</p>
        </div>
    </div>
}